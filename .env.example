# Sao chép thành .env; không commit API key thật.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Hỏi đáp kiến thức: mặc định dùng cùng model văn bản; không cần API key khác.
OPENAI_TUTOR_MODEL=gpt-6-luna
# Mô hình Colab: đường dẫn tương đối tính từ thư mục có manage.py.
# Chép TOÀN BỘ best_model vào đây; OpenAI vẫn xem ảnh gốc và đề xuất kết quả.
AI_LOCAL_ENABLED=true
AI_LOCAL_VOCAB_MODEL_DIR=ai_models/vocabulary/best_model
AI_LOCAL_SPEAKING_MODEL_DIR=ai_models/speaking/best_model
AI_LOCAL_DEVICE=auto
# Nếu dùng Whisper local, cài FFmpeg và đặt trong PATH hoặc khai báo file chạy.
AI_FFMPEG_BINARY=ffmpeg
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: đặt secret ngẫu nhiên riêng và DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
